{
  "session_version": "1.0",
  "session_directory": "data/wa-session/",
  "session_expiry_days": 30,
  "qr_code_display": "terminal",
  "headless_mode": false,
  "timeout": {
    "login": 120000,
    "message": 30000,
    "rate_limit_delay": 5000
  },
  "safety_guards": {
    "require_group_mapping": true,
    "require_live_flag": true,
    "prevent_unmapped_sends": true,
    "rate_limit_enabled": true
  }
}
