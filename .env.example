# =====================================================================
# TUGASKU ENVIRONMENT CONFIGURATION (TEMPLATE)
# =====================================================================
# Salin file ini menjadi .env dan sesuaikan nilainya:
# cp .env.example .env

# --- KREDENSIAL MENTARI LMS UNPAM (Diperbarui otomatis oleh 'npm run login') ---
MENTARI_TOKEN=

# Base URL MENTARI LMS (default: https://mentari.unpam.ac.id)
MENTARI_BASE_URL=https://mentari.unpam.ac.id

# --- DEFAULT MATA KULIAH & PERTEMUAN (Semester 20261 - Kelas 05TPLE003) ---
KODE_COURSE=20261-05TPLE003-22TIF0243
KODE_SECTION=PERTEMUAN_1

# --- SYSTEM & TIMEZONE ---
TIMEZONE=Asia/Jakarta
PORT=3000
HOST=127.0.0.1

# --- TELEGRAM BOT (Opsional - untuk notifikasi otomatis) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
